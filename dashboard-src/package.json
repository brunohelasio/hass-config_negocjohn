{
  "name": "bruno-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard Home Assistant — fonte TypeScript. O bundle compilado vai para config/www/dashboard/.",
  "scripts": {
    "materialize:remote": "python3 ../scripts/build/apply-josh-on-round2-20260822.py && python3 ../scripts/build/apply-premium-tv-remote-round6-20260821.py",
    "build": "npm run materialize:remote && vite build && npm run manifesto && npm run compress",
    "watch": "vite build --watch",
    "typecheck": "npm run materialize:remote && tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "node scripts/deploy.mjs",
    "check": "npm run check:yaml && npm run check:crase && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:yaml": "node ../scripts/validation/check-yaml.mjs",
    "check:crase": "node ../scripts/validation/check-backtick.mjs --tudo",
    "manifesto": "node scripts/publicar-manifesto.mjs",
    "deploy:everex": "node scripts/deploy.mjs --everex",
    "compress": "node scripts/compress-output.mjs"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
